# Copy to .env for local overrides. All values are optional in dev.
ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
# Local default is SQLite. Prod (Neon): postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./aliveline.db
COOKIE_SECURE=false
APP_TZ=Europe/Kyiv
# Optional AI estimates: OpenAI key; heuristic without it.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
