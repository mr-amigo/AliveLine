# Copy to .env (git-ignored). Used by the Makefile for AWS deployment only;
# backend runtime settings live in backend/.env.example.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Email for the $5/month budget alert (recommended)
BUDGET_EMAIL=
# AI estimates (optional): OpenAI key; heuristic without it
OPENAI_API_KEY=

# Payments (Paddle Billing). sandbox until the live account is approved; checkout shows only to BILLING_TESTERS outside production.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
BILLING_TESTERS=
